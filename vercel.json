{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python validate_data.py",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{static/assets/places/**,public/**,data/*.sqlite3,tests/**,*.md,*.txt,*.pyc,__pycache__/**,.kilo/**,tmp-images/**}"
    }
  },
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}