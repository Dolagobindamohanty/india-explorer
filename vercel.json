{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python validate_data.py",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/static/assets/$1" },
    { "source": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|json|webp|woff|woff2|ttf))", "destination": "/static/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}